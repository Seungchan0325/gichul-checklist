# Local: run `npm run db:start`, then copy its API URL and anon key here.
# Production: use the deployed Supabase project URL and publishable/anon key only.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_EXAM_PDF_BASE_URL=/pdfs
# Never add SUPABASE_SERVICE_ROLE_KEY here. The account-deletion Edge Function receives it only from Supabase's server runtime.
